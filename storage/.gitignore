# Саму папку сессий храним в git (нужна на проде), а файлы сессий — нет.
sessions/*
!sessions/.gitkeep

# Флаг техобслуживания (includes/maintenance.php) — состояние конкретного
# окружения (прод/локально), в git попадать не должен: иначе git pull на
# проде мог бы случайно включить/выключить заглушку сам по себе.
maintenance.flag
